APP_ENV=development
DATABASE_URL=sqlite:///./docpilot.db
STORAGE_BUCKET=docpilot-records
STORAGE_REGION=ap-south-1
UPLOAD_DIR=./uploads

# Upload validation
MAX_UPLOAD_MB=20
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.bmp,.tif,.tiff
ALLOWED_CONTENT_TYPES=application/pdf,image/png,image/jpeg,image/webp,image/bmp,image/tiff

# OCR pipeline
OCR_ENGINE=paddle            # paddle (local, default) | pdftext (digital PDFs) | groq (external vision LLM — OPT-IN)
MAX_PAGES=30
MAX_PAGE_PIXELS=4000000
MAX_PROCESSING_SECONDS=600
OCR_MAX_RETRIES=3
JOB_LEASE_SECONDS=300
WORKER_POLL_SECONDS=2

# Groq vision engine (OPT-IN — page images/text leave this machine; see backend/README.md)
# GROQ_API_KEY=             # never commit a real key
# GROQ_API_KEYS=            # optional comma-separated pool, rotated on rate limits
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=1500
GROQ_MAX_TOKENS_RETRY=4000
GROQ_TIMEOUT_SECONDS=60
GROQ_429_MAX_WAITS=4
GROQ_EXTRACTION_ENABLED=false   # LLM structuring pass over OCR text (unverified output)
